{
   "action": {
      "default_icon": {
         "16": "images/icon16.png",
         "32": "images/icon32.png",
         "48": "images/icon48.png"
      },
      "default_title": "ChatGPT"
   },
   "background": {
      "service_worker": "background.js"
   },
   "commands": {
      "open-codex-side-panel": {
         "description": "Open ChatGPT side panel",
         "suggested_key": {
            "default": "Ctrl+Shift+Period",
            "mac": "Command+Shift+Period"
         }
      }
   },
   "content_scripts": [ {
      "all_frames": false,
      "js": [ "content-scripts/chatgpt-website.js" ],
      "matches": [ "https://chatgpt.com/*" ],
      "run_at": "document_end"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https://ab.chatgpt.com https://chatgpt.com https://api.openai.com https://api.openai.org; font-src 'self' https://cdn.openai.com;",
      "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none';"
   },
   "description": "Control your browser with ChatGPT.",
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "32": "images/icon32.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "name": "ChatGPT",
   "optional_permissions": [ "downloads.open" ],
   "permissions": [ "alarms", "bookmarks", "debugger", "downloads", "favicon", "history", "nativeMessaging", "notifications", "scripting", "sessions", "storage", "tabGroups", "tabs", "topSites", "webNavigation", "contextMenus", "sidePanel" ],
   "sandbox": {
      "pages": [ "js-kernel.html" ]
   },
   "side_panel": {
      "default_path": "codex-sidepanel/index.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.2.27259.19709",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "images/cursor-chat.png" ]
   } ]
}
